<resources>
    <string name="app_name">USB Manager</string>
    <string name="app_description">UI for the Magisk/KernelSU root backend that manages USB modes, ADB and trusted computers.</string>

    <!-- MainActivity intro -->
    <string name="intro_module_info">Version: %1$s</string>
    <string name="intro_start">Get Started</string>
    <string name="intro_section_features">Features</string>
    <string name="intro_feature_1">• Detects USB connection events automatically</string>
    <string name="intro_feature_2">• Shows a USB chooser when connected to a computer</string>
    <string name="intro_feature_3">• Available modes: Charge only / File transfer (MTP) / Photo transfer (PTP) / USB tethering (RNDIS) / MIDI</string>
    <string name="intro_feature_4">• Enables USB debugging (ADB) with a single tap</string>
    <string name="intro_feature_5">• Lets Android handle OTG devices natively when the phone acts as USB host, without showing a chooser</string>
    <string name="intro_feature_6">• Turns ADB off after unplug (can be disabled)</string>
    <string name="intro_feature_7">• Stores backend logs under /data/adb/usbmanager/logs</string>
    <string name="intro_section_usage">Usage</string>
    <string name="intro_usage_1">1. Install the full module in Magisk or KernelSU, then reboot</string>
    <string name="intro_usage_2">2. Open the app and confirm that the root backend is running</string>
    <string name="intro_usage_3">3. Connect to a computer with a USB cable; the USB chooser will appear</string>
    <string name="intro_usage_4">4. Choose the USB mode and ADB toggle, then tap \"OK\" to apply</string>
    <string name="intro_usage_5">5. Tap \"Re-check\" to refresh the backend status</string>
    <string name="intro_usage_6">6. Tap \"How to get logs\" to see the root backend log paths</string>

